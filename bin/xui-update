#!/usr/bin/env bash
# ============================================================================
#  xui-update — безопасное авто-обновление компонентов 3x-ui.
#
#    xui-update geodata   — обновить geoip/geosite (списки РФ/обхода). Безопасно.
#    xui-update core      — обновить ядро Xray с проверкой здоровья и откатом.
#    xui-update all       — сначала geodata, затем core.
#
#  Запускается systemd-таймерами (xui-geodata.timer / xui-core.timer) или вручную.
#  Все логи идут в stderr → видны в `journalctl -u xui-geodata -u xui-core`.
# ============================================================================
set -Eeuo pipefail

LIB=/usr/local/share/xui-bootstrap/lib
for m in common xui; do
  # shellcheck source=/dev/null
  [[ -r "$LIB/$m.sh" ]] && . "$LIB/$m.sh"
done
command -v jq   >/dev/null 2>&1 || { echo "xui-update: нужен jq"   >&2; exit 1; }
command -v curl >/dev/null 2>&1 || { echo "xui-update: нужен curl" >&2; exit 1; }
type -t ok >/dev/null 2>&1 || { echo "xui-update: нет lib/common.sh" >&2; exit 1; }

XRAY_LATEST_API="https://api.github.com/repos/XTLS/Xray-core/releases/latest"

xui_api_connect xui-update || { warn "xui-update: API панели недоступно — пропускаю запуск"; exit 0; }

# ---------------------------------------------------------------------------
# geodata: обновляем ТОЛЬКО через штатный API панели (updateGeofile) — он берёт
# файлы из того же источника, что и панель, поэтому имена категорий
# (geosite:category-ru, geoip:ru и т.д.) не разъедутся с нашими правилами.
# Чужой источник намеренно не подставляем: это ломало Xray ранее.
# ---------------------------------------------------------------------------
update_geodata() {
  info "Обновляю geodata (geoip/geosite) через панель…"
  if api POST panel/api/server/updateGeofile 2>/dev/null | jq -e '.success' >/dev/null 2>&1; then
    ok "geodata обновлена"
    return 0
  fi
  warn "geodata: панель вернула ошибку — не обновилось (не критично, правила продолжают работать)"
  return 0
}

# ---------------------------------------------------------------------------
# core: обновляем ядро Xray до последнего релиза с GitHub, проверяем, что оно
# поднялось, и откатываемся при падении.
#
# ВАЖНО (честное ограничение): проверка ловит только «жёсткий» отказ — когда
# ядро не стартует. Регрессии совместимости Reality (ядро работает, но часть
# клиентов молча не коннектится — как было в 26.9.x) автопроверкой НЕ ловятся.
# Поэтому таймер ядра по умолчанию выключен (AUTO_UPDATE_CORE=0).
# ---------------------------------------------------------------------------
_xray_state() { api GET panel/api/server/status 2>/dev/null | jq -r '.obj.xray.state // empty' 2>/dev/null || true; }

# _xray_up — ждёт до ~40 с, пока ядро поднимется. Решение об откате принимаем
# только по однозначному сигналу: пустой ответ API (сбой связи/токена) — это
# повод переподключиться и проверить процесс, а не откатывать рабочее ядро.
_xray_up() {
  local i st
  for i in 1 2 3 4 5 6 7 8; do
    st=$(_xray_state)
    [[ $st == running ]] && return 0
    if [[ -z $st ]]; then
      xui_api_connect xui-update >/dev/null 2>&1 || true
      pgrep -f '/usr/local/x-ui/bin/xray' >/dev/null 2>&1 && [[ $i -ge 3 ]] && return 0
    fi
    sleep 5
  done
  return 1
}

update_core() {
  local cur latest latest_num
  cur=$(xui_xray_version); [[ -n $cur ]] || cur='?'

  latest=$(curl -fsSL -H 'Accept: application/vnd.github+json' "$XRAY_LATEST_API" 2>/dev/null \
           | jq -r '.tag_name // empty' 2>/dev/null || true)
  if [[ -z $latest ]]; then
    warn "core: не удалось узнать последнюю версию Xray (GitHub недоступен) — пропускаю"
    return 0
  fi
  latest_num="${latest#v}"

  if [[ "$cur" == "$latest_num" ]]; then
    ok "Xray уже последней версии ($cur) — обновление не требуется"
    return 0
  fi
  # Защита от случайного даунгрейда: ставим ТОЛЬКО если релиз строго новее
  # текущей версии (на случай pre-release/битого тега от GitHub API).
  if [[ $cur != '?' ]]; then
    local newest; newest=$(printf '%s\n%s\n' "$cur" "$latest_num" | sort -V | tail -1)
    if [[ "$newest" != "$latest_num" ]]; then
      info "Текущая версия Xray ($cur) не старше релиза ($latest_num) — пропускаю"
      return 0
    fi
  fi

  info "Обновляю ядро Xray: ${cur} → ${latest_num} …"
  if ! api POST "panel/api/server/installXray/$latest" 2>/dev/null | jq -e '.success' >/dev/null 2>&1; then
    warn "core: установка $latest не удалась (API) — версия ядра не изменена"
    return 0
  fi
  if _xray_up; then
    ok "Xray обновлён до $(xui_xray_version) и работает"
    return 0
  fi

  # --- откат ---
  warn "Xray $latest_num не поднялся (state≠running) — ОТКАТ на $cur"
  if [[ $cur == '?' ]]; then
    warn "Откат невозможен (не знаю прежнюю версию). Зайди в панель → выбери рабочую версию Xray"
    return 1
  fi
  if api POST "panel/api/server/installXray/v$cur" 2>/dev/null | jq -e '.success' >/dev/null 2>&1; then
    if _xray_up; then
      ok "Откат выполнен — Xray снова $cur и работает"
      return 0
    fi
  fi
  warn "Откат не поднял ядро. Вручную: x-ui restart; journalctl -u x-ui -n 50"
  return 1
}

case "${1:-all}" in
  geodata) update_geodata ;;
  core)    update_core ;;
  all)     update_geodata || true; update_core ;;
  *) echo "usage: xui-update {geodata|core|all}" >&2; exit 2 ;;
esac
