# ============================================================================
#  xui-bootstrap — конфигурация. Скопируй в config.env и заполни под себя.
#  cp config.example.env config.env && nano config.env
# ============================================================================

# --- Маскировка -------------------------------------------------------------
# reality   — Reality-донор (домен не нужен), рекомендуется.
# selfsteal — свой домен + Let's Encrypt + сайт-заглушка (нужна A-запись).
MASK_MODE=reality

# Домен-донор для Reality (обязателен для TLS 1.3 + H2). Примеры: vk.com, www.microsoft.com
REALITY_SNI=vk.com
# Порт донора (по умолчанию $REALITY_SNI:443)
# REALITY_DEST=vk.com:443

# Свой домен и email (только для selfsteal)
DOMAIN=
ACME_EMAIL=

# --- Набор протоколов -------------------------------------------------------
# Какие инбаунды поднять сразу. Доступно:
#   reality-vision  xhttp-reality  grpc-reality  trojan-reality
#   ss2022  hysteria2  tuic  ws-tls (только selfsteal)
# Пустое значение → полный набор ниже.
AUTO_INBOUNDS="reality-vision xhttp-reality grpc-reality trojan-reality ss2022 hysteria2 tuic"

# --- Маршрутизация ----------------------------------------------------------
# 1 — резать трафик на RU-ресурсы на стороне VPS (geoip:ru + .ru/.su/.рф).
BLOCK_RU=1
# 1 — регистрировать WARP (Cloudflare) и гнать через него сервисы, блокирующие
#     IP хостингов (Gemini/Google AI). AliExpress всегда идёт прямым выходом VPS.
ENABLE_WARP=1

# --- Производительность и защита -------------------------------------------
ENABLE_BBR=1          # TCP BBR + fq
ENABLE_DDOS=1         # nftables анти-DDoS (SYN/ICMP-флуд, мусор, защита SSH/панели)

# Тонкая настройка анти-DDoS (можно не трогать):
# DDOS_SYN_RATE=2000   # порог новых SYN в секунду (глобально)
# DDOS_SYN_BURST=3000
# DDOS_ICMP_RATE=50
# DDOS_ICMP_BURST=100
# DDOS_GUARD_RATE=20   # новых подключений/мин на SSH+панель до бана на 1ч

# --- Доступ и безопасность --------------------------------------------------
# 1 — отключить вход по паролю по SSH (нужен настроенный authorized_keys)
SSH_KEYS_ONLY=0
# 0 — панель только через SSH-туннель; 1 — открыть порт панели в интернет
PANEL_PUBLIC=0
# 1 — включить HTTPS панели самоподписанным бессрочным сертификатом (нужно для
#     доступа через браузер; 0 — оставить HTTP, только за туннелем/reverse-proxy)
PANEL_SSL=1

# --- Версии компонентов (пусто = последние стабильные) ----------------------
XUI_VERSION=
XRAY_VERSION=

# --- Прочее -----------------------------------------------------------------
# Доп. порты для UFW (через пробел), например: "8080 9090"
EXTRA_TCP_PORTS=""
EXTRA_UDP_PORTS=""
# Публичный IP/домен сервера (если не указан — определяется автоматически)
SERVER_ADDR=
