# Режим маскировки: reality | selfsteal
MASK_MODE=reality

# Домен-донор для Reality (с поддержкой TLS 1.3 и H2)
REALITY_SNI=vk.com

# Порт донора (по умолчанию $REALITY_SNI:443)
# REALITY_DEST=vk.com:443

# Свой домен (только для режима selfsteal)
DOMAIN=

# Email для сертификата Let's Encrypt (для режима selfsteal)
ACME_EMAIL=

# Версии компонентов (оставь пустыми для установки последних стабильных)
XUI_VERSION=
XRAY_VERSION=

# Блокировать трафик на RU-ресурсы через VPS (1 — да, 0 — нет)
BLOCK_RU=1

# Включить алгоритм BBR (1 — да, 0 — нет)
ENABLE_BBR=1

# Вход по SSH только по ключам (1 — отключить пароли, 0 — оставить вход по паролю)
SSH_KEYS_ONLY=0

# Доступ к веб-панели (0 — только через защищённый SSH-туннель, 1 — открыть порт панели в интернет)
PANEL_PUBLIC=0

# Дополнительные порты для фаервола UFW (через пробел, например: "8080 9090")
EXTRA_TCP_PORTS=""
EXTRA_UDP_PORTS=""

# Публичный IP или домен сервера (если не указан, определяется автоматически)
SERVER_ADDR=
