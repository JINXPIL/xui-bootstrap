#!/usr/sbin/nft -f
# xui-ddos — отдельная nftables-таблица анти-DDoS, работающая ДО правил UFW
# (priority -150). Она только ОТБРАСЫВАЕТ вредный трафик и передаёт остальное
# дальше (return/policy accept), поэтому финальное «allow/deny» остаётся за UFW.
#
# ВАЖНО про безопасность доступа:
#  • Адреса из allowlist пропускаются БЕЗ всяких лимитов (там текущий
#    SSH-администратор) — его нельзя случайно забанить.
#  • Гвардия перебора на SSH — это МЯГКИЙ rate-limit (drop лишних новых
#    соединений), она НЕ вносит IP в чёрный список и НЕ рвёт активную сессию.
#  • Порт панели гвардией не защищается: пачка SYN от браузера на неслушающий
#    порт больше не приводит к бану IP.
#  • Прокси-трафик (в т.ч. UDP Hysteria2/TUIC) по объёму не режется.

table inet xui_ddos
delete table inet xui_ddos

table inet xui_ddos {
    # Белый список (администратор/текущий SSH) — полный обход фильтра.
    set allowlist4 { type ipv4_addr;__ALLOW4__ }
    set allowlist6 { type ipv6_addr;__ALLOW6__ }

    # Чёрный список (заполняется вручную или fail2ban), с таймаутом.
    set blacklist4 { type ipv4_addr; flags timeout; }
    set blacklist6 { type ipv6_addr; flags timeout; }

    chain input {
        type filter hook input priority -150; policy accept;

        # уже установленные соединения и локалхост — не трогаем
        ct state established,related return
        iifname "lo" return

        # администратор — полный обход
        ip  saddr @allowlist4 return
        ip6 saddr @allowlist6 return

        # мусор
        ct state invalid drop

        # чёрный список
        ip  saddr @blacklist4 drop
        ip6 saddr @blacklist6 drop

        # защита от SYN-флуда (глобальный порог с запасом под норму)
        tcp flags & (fin|syn|rst|ack) == syn ct state new \
            limit rate over __SYN_RATE__/second burst __SYN_BURST__ packets drop

        # кривые TCP-флаги (NULL/XMAS и т.п.)
        tcp flags & (fin|syn|rst|psh|ack|urg) == 0 drop
        tcp flags & (fin|syn) == (fin|syn) drop
        tcp flags & (syn|rst) == (syn|rst) drop

        # ICMP-флуд
        ip  protocol icmp icmp type echo-request \
            limit rate over __ICMP_RATE__/second burst __ICMP_BURST__ packets drop
        ip6 nexthdr icmpv6 icmpv6 type echo-request \
            limit rate over __ICMP_RATE__/second burst __ICMP_BURST__ packets drop

        # МЯГКАЯ гвардия перебора ТОЛЬКО на SSH: лишние новые соединения
        # отбрасываются, но IP НЕ банится (никаких add @blacklist).
        tcp dport { __SSH_PORTS__ } ct state new \
            limit rate over __GUARD_RATE__/minute burst __GUARD_BURST__ packets drop
    }
}
