{
  "remark": "VLESS-XHTTP-Reality",
  "enable": true,
  "listen": "",
  "port": 2053,
  "protocol": "vless",
  "settings": {
    "decryption": "none",
    "fallbacks": [],
    "clients": [
      { "id": "__UUID__", "email": "__EMAIL__", "flow": "", "enable": true }
    ]
  },
  "streamSettings": {
    "network": "xhttp",
    "security": "reality",
    "xhttpSettings": {
      "path": "__PATH__",
      "host": "",
      "mode": "auto",
      "noSSEHeader": false,
      "scMaxEachPostBytes": 1000000,
      "scMaxConcurrentPosts": 100,
      "scMinPostsIntervalMs": 30,
      "xPaddingBytes": "100-1000"
    },
    "realitySettings": {
      "show": false,
      "xver": 0,
      "target": "__DEST__",
      "serverNames": ["__SNI__"],
      "privateKey": "__PRIVATE_KEY__",
      "shortIds": ["__SHORT_ID__"],
      "settings": { "publicKey": "__PUBLIC_KEY__", "fingerprint": "chrome", "spiderX": "/" }
    }
  },
  "sniffing": { "enabled": true, "destOverride": ["http", "tls", "quic"], "routeOnly": true }
}
