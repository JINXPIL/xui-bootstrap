{
  "remark": "VLESS-WS-TLS",
  "enable": true,
  "listen": "",
  "port": 8444,
  "protocol": "vless",
  "settings": {
    "decryption": "none",
    "fallbacks": [],
    "clients": [
      { "id": "__UUID__", "email": "__EMAIL__", "flow": "", "enable": true }
    ]
  },
  "streamSettings": {
    "network": "ws",
    "security": "tls",
    "wsSettings": {
      "path": "__PATH__",
      "host": "__SNI__",
      "headers": {}
    },
    "tlsSettings": {
      "serverName": "__SNI__",
      "minVersion": "1.2",
      "maxVersion": "1.3",
      "alpn": ["h2", "http/1.1"],
      "certificates": [
        { "certificateFile": "__CERT_PUB__", "keyFile": "__CERT_KEY__", "ocspStapling": 3600, "usage": "encipherment" }
      ],
      "settings": { "fingerprint": "" }
    }
  },
  "sniffing": { "enabled": true, "destOverride": ["http", "tls", "quic"], "routeOnly": true }
}
