#!/usr/sbin/nft -f
# xui-ddos — отдельная nftables-таблица анти-DDoS, работающая ДО правил UFW
# (priority -150). Она только ОТБРАСЫВАЕТ вредный трафик и передаёт остальное
# дальше (return/policy accept), поэтому финальное «allow/deny» остаётся за UFW.
# Прокси-трафик (в т.ч. UDP Hysteria2/TUIC) намеренно не режется по объёму —
# ограничиваются только флуд, мусорные пакеты и перебор на SSH/панель.

table inet xui_ddos
delete table inet xui_ddos

table inet xui_ddos {
    # Динамический чёрный список (fail2ban/руками добавляет сюда адреса).
    set blacklist4 { type ipv4_addr; flags timeout; }
    set blacklist6 { type ipv6_addr; flags timeout; }

    # Метр перебора новых соединений на чувствительные порты.
    chain input {
        type filter hook input priority -150; policy accept;

        # уже установленные соединения — не трогаем
        ct state established,related return
        iifname "lo" return

        # мусор
        ct state invalid drop

        # ручной/автоматический чёрный список
        ip  saddr @blacklist4 drop
        ip6 saddr @blacklist6 drop

        # защита от SYN-флуда (порог глобальный, с запасом под нормальную нагрузку)
        tcp flags & (fin|syn|rst|ack) == syn ct state new \
            limit rate over __SYN_RATE__/second burst __SYN_BURST__ packets drop

        # флуд новых NULL/XMAS и прочих кривых TCP-флагов
        tcp flags & (fin|syn|rst|psh|ack|urg) == 0 drop
        tcp flags & (fin|syn) == (fin|syn) drop
        tcp flags & (syn|rst) == (syn|rst) drop

        # ICMP-флуд
        ip  protocol icmp icmp type echo-request \
            limit rate over __ICMP_RATE__/second burst __ICMP_BURST__ packets drop
        ip6 nexthdr icmpv6 icmpv6 type echo-request \
            limit rate over __ICMP_RATE__/second burst __ICMP_BURST__ packets drop

        # перебор новых подключений на SSH/панель → в чёрный список на 1 час
        tcp dport { __GUARD_PORTS__ } ct state new \
            meter guard4 { ip  saddr limit rate over __GUARD_RATE__/minute } \
            add @blacklist4 { ip saddr timeout 1h } drop
        tcp dport { __GUARD_PORTS__ } ct state new \
            meter guard6 { ip6 saddr limit rate over __GUARD_RATE__/minute } \
            add @blacklist6 { ip6 saddr timeout 1h } drop
    }
}
